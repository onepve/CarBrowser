<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 顶部常驻车规大胶囊导航条 (高度 56dp) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="4dp">

        <!-- ⬅ 后退 -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_capsule_btn"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="后退" />

        <!-- ➡ 前进 -->
        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_capsule_btn"
            android:src="@drawable/ic_forward"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="前进" />

        <!-- 🔄 刷新 -->
        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_capsule_btn"
            android:src="@drawable/ic_refresh"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="刷新" />

        <!-- 🏠 主页 -->
        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_capsule_btn"
            android:src="@drawable/ic_home"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="主页" />

        <!-- ⛶ 网页纯净全屏切换 -->
        <ImageButton
            android:id="@+id/btn_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_capsule_btn"
            android:src="@drawable/ic_fullscreen"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="纯净全屏" />

        <!-- 地址与搜索输入框 -->
        <LinearLayout
            android:id="@+id/layout_search_box"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/img_search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri" />
        </LinearLayout>

        <!-- ☀️/🌙 日夜模式切换 -->
        <ImageButton
            android:id="@+id/btn_theme_mode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_capsule_btn"
            android:src="@drawable/ic_sun"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="日夜模式" />

        <!-- ⭐ 常用 / 收藏夹胶囊大按钮 (默认常驻显眼) -->
        <LinearLayout
            android:id="@+id/btn_bookmarks"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_capsule_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/img_bookmark_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star" />

            <TextView
                android:id="@+id/text_bookmark_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="常用收藏"
                android:textColor="@color/accent_amber"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ✕ 退出 -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_capsule_btn"
            android:src="@drawable/ic_close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="退出" />
    </LinearLayout>

    <!-- 加载进度条 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/top_bar"
        android:progressDrawable="@color/progress_color"
        android:visibility="gone" />

    <!-- 网页 WebView 核心区 -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progress_bar" />

    <!-- 纯净全屏时右上角半透明悬浮恢复按钮 (默认隐藏) -->
    <ImageButton
        android:id="@+id/btn_exit_fullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_floating_btn"
        android:src="@drawable/ic_fullscreen_exit"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:elevation="10dp"
        android:contentDescription="退出全屏" />

    <!-- 全屏视频播放容器 (默认隐藏) -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</RelativeLayout>
